@model produtoMVC.Models.ProdutoViewModel

<h2>Editar Produto</h2>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />

    <div>
        <label asp-for="Titulo">Título:</label>
        <input asp-for="Titulo" id="Titulo" />
        <span asp-validation-for="Titulo" style="color:red"></span>
    </div>

    <div>
        <label asp-for="Descricao">Descrição:</label>
        <input asp-for="Descricao" id="Descricao" />
        <span asp-validation-for="Descricao" style="color:red"></span>
    </div>

    <div>
        <label asp-for="Preco">Preço:</label>
        <input asp-for="Preco" id="Preco" type="number" step="0.01" />
        <span asp-validation-for="Preco" style="color:red"></span>
    </div>

    <div>
        <label asp-for="Estoque">Estoque:</label>
        <input asp-for="Estoque" id="Estoque" type="number" />
        <span asp-validation-for="Estoque" style="color:red"></span>
    </div>

    <div style="margin-top: 15px;">
        <button type="submit">Salvar</button>
    </div>

    <div style="margin-top: 10px;">
        <a asp-action="Index">â Voltar para lista</a>
    </div>
</form>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
