@model produtoMVC.Models.ProdutoViewModel

<h2>Excluir Produto</h2>

<p>Tem certeza que deseja excluir o produto: <strong>@Model.Titulo</strong>?</p>

<form asp-action="DeleteConfirmed" asp-route-id="@Model.Id" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit">Confirmar Exclusão</button> |
    <a asp-action="Index">Cancelar</a>
</form>
