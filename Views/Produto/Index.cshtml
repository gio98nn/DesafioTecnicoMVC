@model List<produtoMVC.Models.ProdutoViewModel>

<h2>Lista de Produtos</h2>

<a href="/Produto/Create">Novo Produto</a>

<table>
    <thead>
        <tr>
            <th>Título</th>
            <th>Descrição</th>
            <th>Preço</th>
            <th>Estoque</th>
            <th>Ações</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var produto in Model)
        {
            <tr>
                <td>@produto.Titulo</td>
                <td>@produto.Descricao</td>
                <td>@produto.Preco</td>
                <td>@produto.Estoque</td>
                <td>
                    <a href="/Produto/Edit/@produto.Id">Editar</a> |
                    <a href="/Produto/Delete/@produto.Id">Excluir</a>
                </td>
            </tr>
        }
    </tbody>
</table>
